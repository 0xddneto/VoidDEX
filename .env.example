# VoidDEX shares VoidScan's persistent relay admission table. Production fails
# closed when this database is unavailable, preventing duplicate nonce races.
DATABASE_URL=postgres://voidscan:voidscan@localhost:5433/voidscan
DATABASE_URL_UNPOOLED=postgres://voidscan:voidscan@localhost:5433/voidscan

# Dedicated testnet relayer key. Never expose it through a NEXT_PUBLIC variable.
VOIDDEX_RELAYER_PRIVATE_KEY=0x
RELAYER_MIN_ETH_WEI=10000000000000
NEXT_PUBLIC_VOIDDEX_SECONDARY_RELAY_ORIGIN=https://voiddex-relay-secondary.example.workers.dev
RELAY_ONLY=1
RELAY_ALLOWED_ORIGINS=https://voiddex-alpha.vercel.app

# Deployment-only. Keep this local; the browser never receives it.
DEPLOYER_PRIVATE_KEY=0x
PARENT_RPC=https://robinhood-testnet.drpc.org
