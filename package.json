{
  "name": "voiddex",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "tsx script/compile-contracts.ts",
    "deploy:testnet": "tsx script/deploy-chain1-dex-v11.ts",
    "verify:testnet": "tsx script/verify-testnet-v11.ts",
    "dev": "next dev",
    "verify:release": "node scripts/verify-release.mjs",
    "build": "npm run verify:release && next build",
    "start": "next start",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "viem": "^2.56.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "dotenv": "^17.4.2",
    "solc": "0.8.28",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
